<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_nexyor_team_form" model="ir.ui.view">
            <field name="name">nexyor.team.form</field>
            <field name="model">nexyor.team</field>
            <field name="arch" type="xml">
                <form string="Operational Team">
                    <sheet>
                        <div class="oe_title">
                            <label for="name" string="Team Name"/>
                            <h1>
                                <field name="name" placeholder="e.g., Sound Engineering Team A"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="leader_id" options="{'no_create': True}"/>
                                <field name="project_id" options="{'no_create': True}"/>
                            </group>
                            <group>
                                <field name="active" invisible="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Team Members" name="members">
                                <field name="member_ids" options="{'no_create': True}" context="{'list_view_ref': 'hr.view_employee_list'}"/>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <chatter/>
                    </div>
                </form>
            </field>
        </record>

        <record id="view_nexyor_team_list" model="ir.ui.view">
            <field name="name">nexyor.team.list</field>
            <field name="model">nexyor.team</field>
            <field name="arch" type="xml">
                <list string="Operational Teams">
                    <field name="name"/>
                    <field name="leader_id"/>
                    <field name="project_id"/>
                    <field name="member_ids" widget="many2many_tags"/>
                </list>
            </field>
        </record>

        <record id="view_nexyor_team_search" model="ir.ui.view">
            <field name="name">nexyor.team.search</field>
            <field name="model">nexyor.team</field>
            <field name="arch" type="xml">
                <search string="Search Teams">
                    <field name="name" string="Team Name"/>
                    <field name="leader_id" string="Team Leader"/>
                    <field name="project_id" string="Project"/>
                    <field name="member_ids" string="Team Members"/>
                    <separator/>
                    <filter string="With Project" name="with_project" domain="[('project_id', '!=', False)]"/>
                    <filter string="Without Project" name="without_project" domain="[('project_id', '=', False)]"/>
                    <group expand="0" string="Group By">
                        <filter string="Project" name="group_by_project" context="{'group_by': 'project_id'}"/>
                        <filter string="Team Leader" name="group_by_leader" context="{'group_by': 'leader_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_nexyor_team" model="ir.actions.act_window">
            <field name="name">Logistics Teams</field>
            <field name="res_model">nexyor.team</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="view_nexyor_team_list"/>
            <field name="search_view_id" ref="view_nexyor_team_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first operational team
                </p>
                <p>
                    Define teams with a Team Leader and members for event logistics operations.
                </p>
            </field>
        </record>

        <menuitem id="menu_nexyor_team_root"
                  name="Logistics Teams"
                  parent="project.menu_main_pm"
                  sequence="50"
                  action="action_nexyor_team"
                  groups="project.group_project_manager,project.group_project_user"/>
    </data>
</odoo>