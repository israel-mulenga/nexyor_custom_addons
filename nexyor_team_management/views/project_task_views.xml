<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Inherit: Project Task Form View -->
        <record id="view_project_task_form_inherit_nexyor_team" model="ir.ui.view">
            <field name="name">project.task.form.inherit.nexyor.team</field>
            <field name="model">project.task</field>
            <field name="inherit_id" ref="project.view_task_form2"/>
            <field name="arch" type="xml">
                <!-- Add team_id field in the main scheduling group -->
                <xpath expr="//field[@name='user_ids']" position="before">
                    <field name="team_id" options="{'no_create': True}"/>
                </xpath>
            </field>
        </record>

        <!-- Inherit: Project Task Tree View (optional, adds team visibility) -->
        <record id="view_project_task_tree_inherit_nexyor_team" model="ir.ui.view">
            <field name="name">project.task.tree.inherit.nexyor.team</field>
            <field name="model">project.task</field>
            <field name="inherit_id" ref="project.view_task_tree2"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='user_ids']" position="before">
                    <field name="team_id" optional="show"/>
                </xpath>
            </field>
        </record>

        <!-- Inherit: Project Task Search View (adds team filter) -->
        <record id="view_project_task_search_inherit_nexyor_team" model="ir.ui.view">
            <field name="name">project.task.search.inherit.nexyor.team</field>
            <field name="model">project.task</field>
            <field name="inherit_id" ref="project.view_task_search_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='user_ids']" position="after">
                    <field name="team_id" string="Assigned Team"/>
                </xpath>
                <xpath expr="//filter[@name='my_tasks']" position="after">
                    <separator/>
                    <filter string="My Team's Tasks" name="my_team_tasks" domain="[('team_id.leader_id.user_id', '=', uid)]"/>
                </xpath>
            </field>
        </record>

        <!-- Inherit: Project Task Kanban View (optional) -->
        <record id="view_project_task_kanban_inherit_nexyor_team" model="ir.ui.view">
            <field name="name">project.task.kanban.inherit.nexyor.team</field>
            <field name="model">project.task</field>
            <field name="inherit_id" ref="project.view_task_kanban"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='user_ids']" position="after">
                    <field name="team_id"/>
                </xpath>
                <xpath expr="//div[hasclass('oe_kanban_bottom_right') or @class='oe_kanban_bottom_right']" position="before">
                    <div t-if="record.team_id.raw_value" class="o_kanban_inline_block">
                        <span class="fa fa-users text-muted me-1" title="Team"/>
                        <t t-esc="record.team_id.value"/>
                    </div>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
