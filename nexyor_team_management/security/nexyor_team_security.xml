<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Group: Team Leader (Custom functional role for Nexyor) -->
        <record id="group_nexyor_team_leader" model="res.groups">
            <field name="name">Team Leader</field>
            <field name="category_id" ref="base.module_category_services_project"/>
            <field name="implied_ids" eval="[(4, ref('project.group_project_user'))]"/>
            <field name="comment">Team Leaders can view and manage tasks where they are assigned as team leader or are in the user_ids.</field>
        </record>

        <!-- Record Rule: Team Leader can only see their own team's tasks -->
        <record id="rule_project_task_team_leader" model="ir.rule">
            <field name="name">Team Leader: Own Team Tasks Only</field>
            <field name="model_id" ref="project.model_project_task"/>
            <field name="domain_force">[
                '|',
                    ('team_id.leader_id.user_id', '=', user.id),
                    ('user_ids', 'in', [user.id])
            ]</field>
            <field name="groups" eval="[(4, ref('group_nexyor_team_leader'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <!-- Additional rule for team leaders to see tasks where they are direct assignees -->
        <record id="rule_project_task_team_leader_user_ids" model="ir.rule">
            <field name="name">Team Leader: Tasks in User IDs</field>
            <field name="model_id" ref="project.model_project_task"/>
            <field name="domain_force">[
                ('user_ids', 'in', [user.id])
            ]</field>
            <field name="groups" eval="[(4, ref('group_nexyor_team_leader'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>
    </data>
</odoo>
