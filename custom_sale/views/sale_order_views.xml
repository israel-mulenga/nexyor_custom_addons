<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Inherit sale.order form view to add approval workflow -->
    <record id="view_order_form_inherit_approval" model="ir.ui.view">
        <field name="name">sale.order.form.approval</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Add Approve button in header -->
            <xpath expr="//header/button[@name='action_quotation_send']" position="after">
                <field name="x_is_dg_approved" invisible="1"/>
                <button name="action_approve_by_dg" type="object" string="Approuver le devis" 
                    class="oe_highlight" 
                    groups="custom_sale.group_dg"
                    invisible="state not in ('draft', 'sent') or x_is_dg_approved == True"
                    />
            </xpath>

            <!-- add location period-->
            <xpath expr="//group[@name='sale_header']" position="inside">
                <group name="rental_dates" string="Période de l'Événement" invisible="not have_rental_products">
                    <label for="rental_start_date" string="Dates de Location"/>
                    <div class="o_row">
                        <field name="rental_start_date" widget="daterange" options="{'related_end_date': 'rental_end_date'}" placeholder="Début"/>
                        <i class="fa fa-long-arrow-right mx-2" title="Vers" role="img" aria-label="Vers"/>
                        <field name="rental_end_date" widget="daterange" options="{'related_start_date': 'rental_start_date'}" placeholder="Fin"/>
                    </div>
                </group>
            </xpath>
            <!-- Add Logistics Info tab -->
            <notebook position="inside">
                <page string="Info Logistique" translate="1">
                    <group>
                        <field name="notes_logistiques" widget="html" options="{'toolbar': 'full'}"/>
                    </group>
                </page>
                <page string="Information d'approbation" translate="1">
                    <group name="approval_status" string="Approval Status" groups="custom_sale.group_dg">
                        <field name="x_is_dg_approved" string="Approuver par le dg ?" readonly="1"/>
                        <field name="x_deposit_paid" string="Accompte payée ?" readonly="1"/>
                        <field name="x_dg_approved_by" string="Approuver par" readonly="1"/>
                        <field name="x_dg_approved_date" string="Date d'approbation" readonly="1"/>
                    </group>
                </page>
            </notebook>

        </field>
    </record>
</odoo>
