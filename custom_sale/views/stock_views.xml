<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit stock.picking form view to add link to feuille de route -->
    <record id="view_picking_form_inherit_sheet_road" model="ir.ui.view">
        <field name="name">stock.picking.form.feuille.route</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <!-- Add Feuille de Route button in header -->
            <xpath expr="//header" position="inside">
                <button name="%(action_report_sheet_road)d" type="action" string="Imprimer Feuille de Route" class="oe_highlight"/>
            </xpath>
        </field>
    </record>
</odoo>